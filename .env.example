# Accounts (optional: README, "Accounts: setting up sign-in and sync").
# Copy to .env.local for local runs; on Vercel set them as environment variables.
# Without them the app has no sign-in and keeps trips on the device only.

# Built into the app (public)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server only: api/account.ts uses it to delete an account. Never VITE_-prefixed.
SUPABASE_SERVICE_ROLE_KEY=
